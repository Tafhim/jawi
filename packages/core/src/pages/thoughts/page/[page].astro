---
import Layout from '@jawi/core/layouts/MainLayout';
import ThoughtCard from '@jawi/core/components/ThoughtCard';
import ThoughtModal from '@jawi/core/components/ThoughtModal';
import { findThoughts } from '@jawi/core/utils/findThoughts';
import { paginate, generatePaginationPaths } from '@jawi/core/utils/paginate';
import { loadConfig } from '@jawi/core/config';

const config = await loadConfig(Astro.root);

export async function getStaticPaths() {
  const config = await loadConfig(Astro.root);
  const allThoughts = await findThoughts(config.content.dir);
  return generatePaginationPaths(allThoughts, config.content.thoughtsPerPage);
}

const allThoughts = await findThoughts(config.content.dir);
const currentPage = parseInt(Astro.params.page || '1');
const { items: pageThoughts, totalPages, hasPrevious, hasNext } = paginate(allThoughts, currentPage, config.content.thoughtsPerPage);
---

<Layout siteTitle={config.site.title} footerText={config.site.footer} dateFormat={config.display.dateFormat}>
  <div class="thoughts-page">
    <h1>Thoughts (Page {currentPage})</h1>
    <p class="subtitle">Short-form notes and quick ideas</p>

    <div class="feed">
      {pageThoughts.length === 0 ? (
        <p class="empty-message">No thoughts on this page.</p>
      ) : (
        pageThoughts.map((thought) => (
          <ThoughtCard
            key={thought.slug}
            content={thought.content}
            contentHtml={thought.contentHtml}
            time={thought.localTime}
            tags={thought.tags}
            slug={thought.slug}
            color={thought.color}
          />
        ))
      )}
    </div>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="Thought pagination">
        {hasPrevious ? (
          <a
            class="pagination-link bottom-right-notch"
            href={currentPage === 2 ? '/thoughts' : `/thoughts/page/${currentPage - 1}`}
          >Previous</a>
        ) : (
          <a
            class="pagination-link bottom-right-notch"
            href="#"
            style="visibility: hidden; pointer-events: none;"
          >Previous</a>
        )}
        <span class="pagination-info">Page {currentPage} of {totalPages}</span>
        {hasNext ? (
          <a
            class="pagination-link bottom-right-notch"
            href={`/thoughts/page/${currentPage + 1}`}
          >Next</a>
        ) : (
          <a
            class="pagination-link bottom-right-notch"
            href="#"
            style="visibility: hidden; pointer-events: none;"
          >Next</a>
        )}
      </nav>
    )}
  </div>
  <ThoughtModal />
</Layout>

<style>
  .thoughts-page {
    width: 100%;
  }

  .thoughts-page h1 {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0 0 0.25rem 0;
  }

  .subtitle {
    color: #888;
    font-size: 1rem;
    margin: 0 0 1.5rem 0;
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-message {
    color: #888;
    font-size: 1rem;
    text-align: center;
    padding: 2rem 0;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 0;
  }

  .pagination-link {
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: #333;
    color: #fff;
    font-size: 0.875rem;
    transition: background 0.2s ease;
    position: relative;
    display: inline-block;
    --notch-size: 8px;
    --notch-line-width: 16px;
    --notch-line-color: #333;
    --notch-line-offset: 2px;
    --notch-corner-offset: 4px;
  }

  .pagination-link:hover {
    background: #555;
  }

  .pagination-link[disabled],
  .pagination-link[href="#"] {
    color: #999;
    cursor: not-allowed;
  }

  .pagination-info {
    color: #666;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .thoughts-page h1 { font-size: 1.5rem; }

    .pagination {
      gap: 0.75rem;
      padding: 1rem 0;
    }
  }

  @media (max-width: 480px) {
    .thoughts-page h1 { font-size: 1.25rem; }

    .pagination-link {
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
    }
  }
</style>
