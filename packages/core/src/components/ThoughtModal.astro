---
// No server-side props needed -- fully client-side
---

<div id="thought-modal-backdrop" class="modal-backdrop" aria-hidden="true">
  <div class="modal-container" role="dialog" aria-modal="true" aria-labelledby="thought-modal-title">
    <button class="modal-close" aria-label="Close modal">&times;</button>
    <div id="thought-modal-title" class="modal-meta"></div>
    <div id="thought-modal-content" class="modal-content"></div>
    <div class="modal-footer">
      <button class="modal-screenshot" aria-label="Capture screenshot">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        <span class="screenshot-label">Screenshot</span>
        <span class="screenshot-saving" hidden>Saving...</span>
        <span class="screenshot-done" hidden>Done!</span>
      </button>
      <button class="modal-permalink" aria-label="Copy permalink">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <span class="permalink-label">Copy permalink</span>
        <span class="permalink-copied" hidden>Copied!</span>
      </button>
    </div>
  </div>
</div>

<!-- Load marked from CDN for client-side markdown rendering -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    // ── Config ─────────────────────────────────────────────────────────

    // Fetch watermark config from framework config
    let watermarkText = '';
    let watermarkStyle = 'diagonal';
    try {
      const config = await fetch('/_jawi_config.json').then(r => r.json());
      const wm = config?.site?.watermark;
      if (wm) {
        // Support both new object format and legacy string format
        if (typeof wm === 'object') {
          watermarkText = wm.text || '';
          watermarkStyle = wm.style || 'diagonal';
        } else if (typeof wm === 'string') {
          watermarkText = wm;
          watermarkStyle = 'diagonal';
        }
      }
    } catch {
      // Config not available -- watermark disabled
    }

    // Watermark rendering parameters — tweak to adjust the tiled diagonal pattern
    const WATERMARK = {
      fontSize: 14,
      spacing: 120,
      angle: -30 * Math.PI / 180,
      opacity: 0.15,
      color: '#fff',
    };

    // ── DOM References ─────────────────────────────────────────────────

    const backdrop = document.getElementById('thought-modal-backdrop');
    const modalContainer = backdrop?.querySelector('.modal-container');
    const closeBtn = backdrop?.querySelector('.modal-close');
    const titleEl = document.getElementById('thought-modal-title');
    const contentEl = document.getElementById('thought-modal-content');

    const screenshotBtn = backdrop?.querySelector('.modal-screenshot');
    const screenshotLabel = screenshotBtn?.querySelector('.screenshot-label');
    const screenshotSaving = screenshotBtn?.querySelector('.screenshot-saving');
    const screenshotDone = screenshotBtn?.querySelector('.screenshot-done');

    const permalinkBtn = backdrop?.querySelector('.modal-permalink');
    const permalinkLabel = permalinkBtn?.querySelector('.permalink-label');
    const permalinkCopied = permalinkBtn?.querySelector('.permalink-copied');

    let currentSlug = '';

    // ── Helpers ────────────────────────────────────────────────────────

    function normalizeTag(tag) {
      return tag.replace(/^#+/, '').toLowerCase();
    }

    // Read computed padding from a real list element, fallback to 40px
    function getBasePadding(container) {
      const sampleList = container.querySelector('ul, ol');
      return sampleList
        ? parseFloat(window.getComputedStyle(sampleList).paddingLeft) || 40
        : 40;
    }

    // Inject explicit bullets/numbers for html2canvas (which doesn't render native markers)
    function injectListMarkers(clone) {
      const basePadding = getBasePadding(clone);

      clone.querySelectorAll('ul').forEach((ul) => {
        ul.querySelectorAll(':scope > li').forEach((li) => {
          const bullet = document.createElement('span');
          bullet.textContent = '\u2022';
          bullet.style.cssText = 'margin-right:0.5rem;display:inline-block;';
          li.insertBefore(bullet, li.firstChild);
        });
      });

      clone.querySelectorAll('ol').forEach((ol) => {
        ol.style.listStyleType = 'none';
        let i = 0;
        ol.querySelectorAll(':scope > li').forEach((li) => {
          const num = document.createElement('span');
          num.textContent = `${++i}.`;
          num.style.cssText = 'margin-right:0.35rem;margin-left:-28px;display:inline-block;';
          li.insertBefore(num, li.firstChild);
        });
      });

      // Set inline padding-left on all lists for nesting depth
      clone.querySelectorAll('ul, ol').forEach((list) => {
        let depth = 0;
        let parent = list.parentElement;
        while (parent) {
          if (parent.tagName === 'LI') depth++;
          parent = parent.parentElement;
        }
        list.style.paddingLeft = `${basePadding + depth * 3}px`;
      });
    }

    // ── Screenshot ─────────────────────────────────────────────────────

    // Clone the modal off-screen, hide chrome, prepare list markers
    function prepareScreenshotClone(modalContainer) {
      const clone = modalContainer.cloneNode(true);
      clone.style.position = 'fixed';
      clone.style.left = '-9999px';
      clone.style.top = '0';
      clone.style.maxHeight = 'none';
      clone.style.overflowY = 'visible';

      // Hide chrome elements
      const cloneClose = clone.querySelector('.modal-close');
      const cloneFooter = clone.querySelector('.modal-footer');
      if (cloneClose) cloneClose.style.display = 'none';
      if (cloneFooter) cloneFooter.style.display = 'none';

      // Inject explicit list markers for html2canvas
      injectListMarkers(clone);

      return clone;
    }

    // Draw a diagonal tiled watermark directly onto the canvas.
    // Runs AFTER html2canvas capture — no DOM involvement.
    function drawWatermarkDiagonal(canvas, text) {
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;

      // Fully reset canvas state — html2canvas may leave clipping paths,
      // transforms, or composite operations that block drawing.
      ctx.restore();
      ctx.restore();
      ctx.restore();
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.beginPath();
      ctx.rect(0, 0, W, H);
      ctx.clip();
      ctx.globalCompositeOperation = 'source-over';

      ctx.globalAlpha = WATERMARK.opacity;
      ctx.fillStyle = WATERMARK.color;
      ctx.font = `${WATERMARK.fontSize}px monospace`;
      ctx.textBaseline = 'middle';

      const tw = ctx.measureText(text).width;
      const diag = Math.sqrt(W * W + H * H);

      ctx.translate(W / 2, H / 2);
      ctx.rotate(WATERMARK.angle);

      for (let y = -diag; y <= diag; y += WATERMARK.spacing) {
        for (let x = -diag; x <= diag; x += tw + WATERMARK.spacing) {
          ctx.fillText(text, x, y);
        }
      }
      ctx.restore();
    }

    const WATERMARK_RIGHT_SPACING = WATERMARK.spacing + 90;

    // Draw a right-side vertical watermark directly onto the canvas.
    // Text is rotated 90 degrees and repeats along the right edge of the image.
    function drawWatermarkRight(canvas, text) {
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;

      // Fully reset canvas state
      ctx.restore();
      ctx.restore();
      ctx.restore();
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.beginPath();
      ctx.rect(0, 0, W, H);
      ctx.clip();
      ctx.globalCompositeOperation = 'source-over';

      ctx.globalAlpha = WATERMARK.opacity;
      ctx.fillStyle = WATERMARK.color;
      ctx.font = `${WATERMARK.fontSize}px monospace`;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'right';

      const margin = 20;
      const x = W - margin;
      const step = WATERMARK_RIGHT_SPACING;

      for (let y = 0; y <= H; y += step) {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(-Math.PI / 2);
        ctx.fillText(text, 0, 0);
        ctx.restore();
      }
      ctx.restore();
    }

    async function captureScreenshot() {
      if (!modalContainer) return;

      // Button feedback
      if (screenshotLabel) screenshotLabel.hidden = true;
      if (screenshotSaving) screenshotSaving.hidden = false;
      screenshotBtn.disabled = true;

      try {
        // Wait for fonts
        if (document.fonts?.ready) await document.fonts.ready;
        await new Promise(r => setTimeout(r, 200));

        // Clone modal off-screen and prepare it
        const clone = prepareScreenshotClone(modalContainer);
        document.body.appendChild(clone);

        // Dynamic import to avoid SSR bundling
        const { default: html2canvas } = await import('html2canvas');

        const canvas = await html2canvas(clone, {
          backgroundColor: '#1a1a1a',
          scale: window.devicePixelRatio || 2,
          logging: false,
        });

        // Remove the off-screen clone
        document.body.removeChild(clone);

        // Apply watermark if configured
        if (watermarkText) {
          if (watermarkStyle === 'right') {
            drawWatermarkRight(canvas, watermarkText);
          } else {
            drawWatermarkDiagonal(canvas, watermarkText);
          }
        }

        // Download via blob
        canvas.toBlob((blob) => {
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          const slug = currentSlug ? `thought-${currentSlug}` : `thought-${Date.now()}`;
          a.download = `${slug}.png`;
          a.href = url;
          a.click();
          URL.revokeObjectURL(url);

          // Show "Done!" feedback
          if (screenshotSaving) screenshotSaving.hidden = true;
          if (screenshotDone) screenshotDone.hidden = false;
          setTimeout(() => {
            if (screenshotDone) screenshotDone.hidden = true;
            if (screenshotLabel) screenshotLabel.hidden = false;
          }, 2000);
        }, 'image/png');

      } catch (err) {
        console.error('Screenshot failed:', err);
        if (screenshotSaving) screenshotSaving.hidden = true;
        if (screenshotLabel) screenshotLabel.hidden = false;
      } finally {
        screenshotBtn.disabled = false;
      }
    }

    // ── Modal Lifecycle ────────────────────────────────────────────────

    function closeModal() {
      if (!backdrop) return;
      backdrop.classList.remove('visible');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.documentElement.style.overflow = '';
      if (modalContainer) modalContainer.style.background = '';
      currentSlug = '';
    }

    function openModal(data) {
      if (!backdrop || !titleEl || !contentEl) return;

      currentSlug = data.slug || '';

      // Apply gradient background from the card
      if (modalContainer) {
        modalContainer.style.background = data.gradient || '';
      }

      // Use pre-formatted display time from ThoughtCard (server-side formatDate)
      const displayTime = data.displayTime || '';

      let tagsHtml = '';
      if (data.tags && data.tags.length > 0) {
        tagsHtml = '<div class="modal-tags">' +
          data.tags.map(t => {
            const tagSlug = normalizeTag(t);
            return `<a class="modal-tag" href="/tags/${tagSlug}">${t}</a>`;
          }).join('') +
          '</div>';
      }

      titleEl.innerHTML = `<time datetime="${data.time || ''}">${displayTime}</time>${tagsHtml}`;

      // Reformat modal time to user's local timezone (if PUBLIC_TIMEZONE=USER)
      const modalTimeEl = titleEl.querySelector('time');
      if (modalTimeEl && window.__reformatModalTime && data.time) {
        window.__reformatModalTime(data.time, modalTimeEl);
      }

      // Use pre-rendered HTML (with CodeContent embeds resolved) if available,
      // otherwise fall back to client-side markdown parsing
      if (data.contentHtml) {
        contentEl.innerHTML = data.contentHtml;
      } else {
        contentEl.innerHTML = window.marked.parse(data.content);
      }

      backdrop.classList.add('visible');
      backdrop.setAttribute('aria-hidden', 'false');

      // Lock body scroll - prevent background page from scrolling
      const scrollY = window.scrollY;
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';

      closeBtn?.focus();
    }

    // ── Button Actions ─────────────────────────────────────────────────

    function copyPermalink() {
      if (!currentSlug) return;
      const url = `${window.location.origin}/?thought=${currentSlug}`;
      navigator.clipboard.writeText(url).then(() => {
        if (permalinkLabel) permalinkLabel.hidden = true;
        if (permalinkCopied) permalinkCopied.hidden = false;
        setTimeout(() => {
          if (permalinkLabel) permalinkLabel.hidden = false;
          if (permalinkCopied) permalinkCopied.hidden = true;
        }, 2000);
      });
    }

    // ── Event Listeners ────────────────────────────────────────────────

    // Thought card clicks (event delegation — single listener for all cards)
    document.addEventListener('click', (e) => {
      const card = e.target.closest('.thought-card');
      if (!card) return;
      if (e.target.closest('a')) return; // Don't open modal if clicking a link

      e.preventDefault();
      openModal({
        slug: card.dataset.slug,
        content: card.dataset.content,
        contentHtml: card.dataset.contentHtml,
        time: card.dataset.time,
        displayTime: card.dataset.displayTime,
        tags: JSON.parse(card.dataset.tags),
        gradient: window.getComputedStyle(card).background,
      });
    });

    // Close on button click
    closeBtn?.addEventListener('click', closeModal);

    // Copy permalink
    permalinkBtn?.addEventListener('click', copyPermalink);

    // Capture screenshot
    screenshotBtn?.addEventListener('click', captureScreenshot);

    // Close on backdrop click (outside modal)
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop?.classList.contains('visible')) {
        closeModal();
      }
    });

    // Prevent scroll bleed-through
    if (modalContainer) {
      modalContainer.addEventListener('wheel', (e) => {
        if (!backdrop?.classList.contains('visible')) return;
        const atTop = modalContainer.scrollTop <= 0;
        const atBottom =
          modalContainer.scrollTop + modalContainer.clientHeight >= modalContainer.scrollHeight;
        if ((atTop && e.deltaY < 0) || (atBottom && e.deltaY > 0)) {
          e.preventDefault();
        }
      }, { passive: false });
    }

    // ── Auto-open from URL ─────────────────────────────────────────────

    const params = new URLSearchParams(window.location.search);
    const thoughtSlug = params.get('thought');
    if (thoughtSlug) {
      const card = document.querySelector(`.thought-card[data-slug="${thoughtSlug}"]`);
      if (card) {
        // Card is on the page -- open modal from card data
        setTimeout(() => {
          openModal({
            slug: card.dataset.slug,
            content: card.dataset.content,
            contentHtml: card.dataset.contentHtml,
            time: card.dataset.time,
            displayTime: card.dataset.displayTime,
            tags: JSON.parse(card.dataset.tags),
            gradient: window.getComputedStyle(card).background,
          });
        }, 100);
      } else {
        // Card not on this page -- fetch JSON endpoint as fallback
        fetch(`/thoughts/${thoughtSlug}.json`)
          .then((res) => {
            if (!res.ok) throw new Error('not found');
            return res.json();
          })
          .then((data) => {
            setTimeout(() => {
              openModal({
                slug: data.slug,
                content: data.content,
                contentHtml: data.contentHtml,
                time: data.time,
                displayTime: data.displayTime,
                tags: data.tags,
                gradient: data.gradient || undefined,
              });
            }, 100);
          })
          .catch(() => {
            // Silently do nothing if the JSON endpoint 404s
          });
      }
    }
  });
</script>

<style is:global>
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  padding: 1rem;
}

.modal-backdrop.visible {
  opacity: 1;
  pointer-events: auto;
}

.modal-container {
  background: #1a1a1a;
  border: 1px solid #333;
  border-radius: 12px;
  max-width: 600px;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 2rem;
  position: relative;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  background-size: cover;
  background-repeat: no-repeat;
}

.modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: none;
  border: none;
  color: #888;
  font-size: 1.5rem;
  cursor: pointer;
  line-height: 1;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  transition: color 0.2s, background 0.2s;
}

.modal-close:hover {
  color: #fff;
  background: #333;
}

.modal-meta {
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #333;
}

.modal-meta time {
  color: #888;
  font-size: 0.85rem;
}

.modal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-top: 0.5rem;
}

.modal-tag {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  background: #1a1a1a;
  border: 1px solid #333;
  border-radius: 4px;
  font-size: 0.8rem;
  color: #aaa;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}

.modal-tag:hover {
  background: #333;
  color: #fff;
}

.modal-content {
  color: #e0e0e0;
  font-size: 1rem;
  line-height: 1.7;
  word-wrap: break-word;
}

.modal-content p {
  margin-bottom: 1rem;
}

.modal-content p:has(+ .code-embed) {
  margin-bottom: 0;
}

.modal-content img {
  display: block;
  margin: 1rem auto;
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}

.modal-content code {
  background: #0d0d0d;
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  font-size: 0.9em;
}

.modal-content pre {
  background: #0d0d0d;
  padding: 1rem;
  border-radius: 6px;
  overflow-x: auto;
  margin: 1rem 0;
}

.modal-content pre code {
  background: none;
  padding: 0;
}

.modal-footer {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid #333;
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
}

.modal-screenshot,
.modal-permalink {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.75rem;
  background: #1a1a1a;
  border: 1px solid #333;
  border-radius: 4px;
  font-size: 0.8rem;
  color: #888;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}

.modal-screenshot:hover,
.modal-permalink:hover {
  background: #333;
  color: #fff;
  border-color: #555;
}

.modal-screenshot:disabled,
.modal-permalink:disabled {
  opacity: 0.6;
  cursor: wait;
}

.modal-screenshot svg,
.modal-permalink svg {
  flex-shrink: 0;
}

.screenshot-saving {
  color: #facc15;
}

.screenshot-done,
.permalink-copied {
  color: #4ade80;
}

@media (max-width: 768px) {
  .modal-container {
    padding: 1.5rem;
    max-height: 90vh;
    max-width: 90vw;
  }
}

@media (max-width: 480px) {
  .modal-container {
    padding: 1.25rem;
  }

  .modal-content {
    font-size: 0.9rem;
  }
}
</style>
